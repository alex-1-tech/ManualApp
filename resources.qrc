<RCC>
    <qresource prefix="/">
        <!-- first start -->
        <file>qml/Start.qml</file>

        <!-- main -->
        <file>qml/Main.qml</file>
        <file>qml/Activate.qml</file>
        <file>qml/Admin.qml</file>
        <file>qml/Settings.qml</file>
        <file>qml/InstallPO.qml</file>

        <!-- models -->
        <file>qml/models/DynamicFormRenderer.qml</file>
    
        <!-- dasboard -->
        <file>qml/ModelSelectionPage.qml</file>
        <file>qml/ModelSelectionCard.qml</file>

        <!-- components -->
        <file>qml/components/FormField.qml</file>
        <file>qml/components/CardSection.qml</file>
        <file>qml/components/SettingCheckBox.qml</file>
        <file>qml/components/ModelSettingCheckBox.qml</file>
        <file>qml/components/ModelSettingDate.qml</file>
        <file>qml/components/SettingsUploadPopup.qml</file>
        <file>qml/components/ConfirmSavePopup.qml</file>

        <!-- styles -->
        <file>qml/styles/qmldir</file>
        <file>qml/styles/Theme.qml</file>

        <!-- jsons -->
        <file>media/jsons/models.json</file>

        <!-- icons -->
        <file>media/icons/icon-settings.svg</file>
        <file>media/icons/icon-dashboard.svg</file>
        <file>media/icons/icon-servers.svg</file>
        <file>media/icons/icon-about.svg</file>
        <file>media/icons/icon-rules.svg</file>
        <file>media/icons/icon-reports.svg</file>
        <file>media/icons/icon-checkmark.svg</file>
        <file>media/icons/icon-activate.svg</file>
        <file>media/icons/icon-admin.svg</file>
        <file>media/icons/app.png</file>
        <file>media/icons/logo.png</file>
        
        <!-- js -->
        <file>qml/utils/Utils.js</file>
        <file>qml/utils/DateUtils.js</file>
    </qresource>
</RCC>